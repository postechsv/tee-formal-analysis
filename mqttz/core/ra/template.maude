--- This file defines the MQT-TZ RA programs.  It is generated by tools/lang-preprocess.py from
--- mqttz/core/ra/template.maude and the [ra.host] table of mqttz/model-checking.toml:
--- hot_cache/host/main.c (upstream MQT-TZ) with model.patch, and fix.patch for the patched program.

--- This module defines the original MQT-TZ RA program, mqttzHost, and the program after the
--- code-level patch fix.patch, mqttzHostPatched: a message whose re-encryption failed is
--- discarded.

mod MQTTZ-RA-PROGRAM is
  pr MQTTZ-CLIENT-DECL .

  op mqttzHost : -> Program [ctor] .
---@program mqttzHost

  op mqttzHostPatched : -> Program [ctor] .
---@program mqttzHostPatched
endm
