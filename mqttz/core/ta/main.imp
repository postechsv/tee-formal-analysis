    struct MqttzClient {
      char * cliId ;
      char * iv ;
      char * data ;
    } ;

    void main (int command, (struct MqttzClient) * origin, (struct MqttzClient) * dest, TEE-Result & ret) {
      struct AesCipher session ;
      session . algo := # anyAlgo ;
      session . mode := # anyMode ;
      session . keySize := # anyKeySize ;
      session . opHandle := # null ;
      session . keyHandle := # null ;

      if (command == # TA-REENCRYPT) {
        ret := payloadReencryption(addr(session), origin -> cliId, origin -> iv, origin -> data, dest -> cliId, dest -> data) ;
      } else {
        ret := # errorNotSupported ;
      }
    }
