--- This file defines the MQT-TZ TA programs.  It is generated by tools/ta2imp/ta2imp.py from
--- case-studies/mqttz/ta/template.maude and the [ta.broker] table of case-studies/mqttz/mqttz.toml:
--- hot_cache_ta.c (upstream MQT-TZ) with model.patch, and fix.patch for the patched program.

mod MQTTZ-TA-PROGRAM-DECL is
  pr TEE-IMP-STRUCT-DECL .
  pr MQTTZ-DATA .
  pr MQTTZ-CONSTANTS .
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .
  pr MQTTZ-PROGRAM-DECL .

  ops err exit : -> Label [ctor] .
  op AesCipher : -> ImpType [ctor] .
endm

--- This module defines the original MQT-TZ TA program.

mod MQTTZ-TA-PROGRAM is
  pr MQTTZ-TA-PROGRAM-DECL .

  op mqttzTA : -> Program [ctor] .
---@program mqttzTA
endm

--- This module defines the MQT-TZ TA program after the code-level patch fix.patch: a failed
--- alloc_resources returns TEE_ERROR_OUT_OF_MEMORY.

mod MQTTZ-TA-PROGRAM-PATCHED is
  pr MQTTZ-TA-PROGRAM-DECL .

  op mqttzTaPatched : -> Program [ctor] .
---@program mqttzTaPatched
endm
