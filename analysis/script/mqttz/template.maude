--- This file defines the MQT-TZ TA program.

--- This module defines the constants used in the MQT-TZ TA program.

fmod MQTTZ-DATA is
  pr CRYPTO-KEY-SIZE .

  op TA-AES-KEY-SIZE : -> Nat [ctor] .
  eq TA-AES-KEY-SIZE = 256 .

  op TA-AES-MODE-ENCODE : -> Nat [ctor] .
  eq TA-AES-MODE-ENCODE = 1 .
  op TA-AES-MODE-DECODE : -> Nat [ctor] .
  eq TA-AES-MODE-DECODE = 0 .

  op TA-REENCRYPT : -> Nat [ctor] .
  eq TA-REENCRYPT = 3 .
endfm

mod MQTTZ-TA-PROGRAM-DECL is
  pr TEE-IMP-STRUCT-DECL .
  pr MQTTZ-DATA .
  pr MQTTZ-CONSTANTS .
  pr TEE-BEHAVIOR .
  pr TEE-IMP-BEHAVIOR .
  pr MQTTZ-PROGRAM-DECL .

  ops err exit : -> Label [ctor] .
  op dummyIv : -> List{Data} [ctor] .
  op AesCipher : -> ImpType [ctor] .
endm

--- This module defines the original MQT-TZ TA program.

mod MQTTZ-TA-PROGRAM is
  pr MQTTZ-TA-PROGRAM-DECL .

  op mqttzTA : -> Program [ctor] .


--- This program is translated automatically from "script/mqttz/preprocessed-ta.c" by "script/c2imp.py";
