#!/usr/bin/env python3
"""Run every model-checking run of a table of the paper: p1 .. p6 under the threats non, oom, msg.

  run-exp TABLE [-non-parallel] [-j N]

  TABLE          table2: the original RA and TA (Table 2 of the paper)
                 table3: the patched RA and TA (Table 3 of the paper)
                 smoke: a quick test of the scripts (under a minute), the original RA and TA:
                 p3 non (holds), p3 oom and p2 msg (counterexamples)
  -non-parallel  one run after the other; without it the runs go in parallel
  -j N           at most N runs at a time (default: the number of CPUs)

The Maude files and the logs go to mqttz/output/TABLE/maude-files and mqttz/output/TABLE/logs.
In mqttz/output/, ../scripts/gen-report TABLE writes TABLE-report.csv, and
../scripts/gen-table TABLE-report.csv writes TABLE.html.
"""
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

HERE = Path(__file__).resolve().parent
CASE = HERE.parent
RUN = HERE / "run"

TABLES = {"table2": "normal", "table3": "-patch", "smoke": "normal"}
THREATS = ["non", "oom", "msg"]


def runs(table):
    if table == "smoke":
        return [("p3", "non"), ("p3", "oom"), ("p2", "msg")]
    return [(f"p{v}", t) for v in range(1, 7) for t in THREATS]


def main(argv):
    if not argv or argv[0] not in TABLES:
        print("error: wrong table")
        sys.exit(65)
    table, opts = argv[0], argv[1:]
    sequential = "-non-parallel" in opts
    jobs = os.cpu_count() or 1
    if "-j" in opts:
        jobs = int(opts[opts.index("-j") + 1])

    prog = TABLES[table]
    out = CASE / "output" / table
    mf, logs = str(out / "maude-files"), str(out / "logs")

    def cmd(prop, threat, silent):
        c = [sys.executable, str(RUN), prop, threat, prog, mf, logs]
        return c + (["-silent"] if silent else [])

    todo = runs(table)
    if sequential:
        for prop, threat in todo:
            subprocess.run(cmd(prop, threat, silent=False), check=True)
        return

    done = 0
    with ThreadPoolExecutor(max_workers=jobs) as pool:
        futs = {pool.submit(subprocess.run, cmd(p, t, silent=True), check=True): (p, t)
                for p, t in todo}
        for fut in as_completed(futs):
            fut.result()
            done += 1
            p, t = futs[fut]
            print(f"[{done}/{len(todo)}] {p} {t}", flush=True)


if __name__ == "__main__":
    main(sys.argv[1:])
