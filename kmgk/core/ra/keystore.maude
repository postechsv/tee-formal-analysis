--- A client of the Keymaster TA (keystore through the Keymaster HAL of linaro-swg/kmgk, C++),
--- written in the model's syntax: it opens a session with the Keymaster TA and calls begin, update,
--- finish and abort with request and response structs, as the TA of the model takes them, see
--- model.patch of the TA, 5.  The structs are those of the TA program.

mod KEYSTORE-PROGRAM is
  pr KEYMASTER-TA-PROGRAM-DECL .

  op KEYMASTER : -> AppId [ctor] .
  ops ks kr kres breq bresp ureq uresp freq fresp areq aresp kblob ktoken msg sig opH : -> Var [ctor] .

  --- kmStructs: the structs of the requests and the responses (keystore_ta.c with model.patch).
  op kmStructs : -> Program .
  eq kmStructs =
    struct HwAuthTokenT { int version ; int challenge ; int userId ; int authenticatorId ;
                          int authenticatorType ; int timestamp ; char hmac ; } ;
    struct KeymasterKeyBlobT { char keyMaterial ; int userSecureId ; int userAuthType ;
                               bool noAuthRequired ; bool authTimeout ; } ;
    struct KmBeginRequestT { int purpose ; (struct KeymasterKeyBlobT) * key ;
                             (struct HwAuthTokenT) * authToken ; } ;
    struct KmBeginResponseT { int error ; int opHandle ; } ;
    struct KmUpdateRequestT { int opHandle ; (struct HwAuthTokenT) * authToken ; char * input ; } ;
    struct KmUpdateResponseT { int error ; } ;
    struct KmFinishRequestT { int opHandle ; (struct HwAuthTokenT) * authToken ; char * input ;
                              char * signature ; } ;
    struct KmFinishResponseT { int error ; char output ; } ;
    struct KmAbortRequestT { int opHandle ; } ;
    struct KmAbortResponseT { int error ; } ; .

  op ksDecls : -> Program .
  eq ksDecls =
    TEEC-Session ks ; TEE-Result kr ; TEE-Result kres ;
    struct KmBeginRequestT breq ; struct KmBeginResponseT bresp ;
    struct KmUpdateRequestT ureq ; struct KmUpdateResponseT uresp ;
    struct KmFinishRequestT freq ; struct KmFinishResponseT fresp ;
    struct KmAbortRequestT areq ; struct KmAbortResponseT aresp ;
    struct KeymasterKeyBlobT kblob ; struct HwAuthTokenT ktoken ; char msg ; char sig ; int opH ; .

  --- kmOpen: TEEC_OpenSession with the Keymaster TA.
  op kmOpen : -> Program .
  eq kmOpen = kr := teecOpenSession(# KEYMASTER, ks) ; .

  --- kmClose: TEEC_CloseSession of the session.
  op kmClose : -> Program .
  eq kmClose = kr := teecCloseSession(ks) ; .

  --- noAuthKey(D): the key blob of an HMAC key with the key data D and KM_TAG_NO_AUTH_REQUIRED.
  op noAuthKey : AttrValue -> Program .
  var V : AttrValue .
  vars D : Data .
  var N : Nat .
  eq noAuthKey(V) =
    kblob . keyMaterial := # V ; kblob . userSecureId := # 0 ; kblob . userAuthType := # 0 ;
    kblob . noAuthRequired := # true ; kblob . authTimeout := # false ; .

  --- kmBegin(P): begin an operation of purpose P with the key blob kblob and no auth token; the
  --- handle goes to opH.
  op kmBegin : Nat -> Program .
  eq kmBegin(N) =
    breq . purpose := # N ; breq . key := addr(kblob) ; breq . authToken := nullptr ;
    kr := teecInvokeCommand(ks, # main, (# KM-BEGIN, addr(breq), addr(bresp), addr(kres))) ;
    opH := bresp . opHandle ; .

  --- kmUpdate(D): update the operation opH with the input D.
  op kmUpdate : Data -> Program .
  eq kmUpdate(D) =
    msg := # D ; ureq . opHandle := opH ; ureq . authToken := nullptr ; ureq . input := addr(msg) ;
    kr := teecInvokeCommand(ks, # main, (# KM-UPDATE, addr(ureq), addr(uresp), addr(kres))) ; .

  --- kmFinish(D): finish the operation opH with the input D.
  op kmFinish : Data -> Program .
  eq kmFinish(D) =
    msg := # D ; freq . opHandle := opH ; freq . authToken := nullptr ; freq . input := addr(msg) ;
    freq . signature := addr(sig) ;
    kr := teecInvokeCommand(ks, # main, (# KM-FINISH, addr(freq), addr(fresp), addr(kres))) ; .
endm
