    void main (int command, int sessAlgo, int sessMode, int sessKeySize, TEE-OperationHandle sessOpHandle, TEE-ObjectHandle sessKeyHandle, TEE-ObjectId oriCliId, TEE-Buffer oriCliIv, TEE-Buffer oriCliData, TEE-ObjectId destCliId, TEE-Result & ret, TEE-Buffer & destCliData) {
      struct AesCipher session ;
      session . algo := sessAlgo ;
      session . mode := sessMode ;
      session . keySize := sessKeySize ;
      session . opHandle := sessOpHandle ;
      session . keyHandle := sessKeyHandle ;

      if (command == # TA-REENCRYPT) {
        ret := payloadReencryption(addr(session), oriCliId, oriCliIv, oriCliData, destCliId, destCliData) ;
      } else {
        ret := # errorNotSupported ;
      }
    }
