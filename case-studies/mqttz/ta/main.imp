    void main (int command, TEE-Algorithm sessAlgo, TEE-OperationMode sessMode, int sessKeySize, TEE-Handle sessOpHandle, TEE-Handle sessKeyHandle, TEE-ObjectId oriCliId, TEE-Buffer oriCliIv, TEE-Buffer oriCliData, TEE-ObjectId destCliId, TEE-Result & ret, TEE-Buffer & destCliData) {
      struct AesCipher session ;
      session . algo := sessAlgo ;
      session . mode := sessMode ;
      session . keySize := sessKeySize ;
      session . opHandle := sessOpHandle ;
      session . keyHandle := sessKeyHandle ;

      if (command == # TA-REENCRYPT) {
        ret := payloadReencryption(session, oriCliId, oriCliIv, oriCliData, destCliId, destCliData) ;
      } else {
        ret := # errorNotSupported ;
      }
    }
